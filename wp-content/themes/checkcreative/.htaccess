# Bloquea archivos de build/desarrollo que no deberían ser públicos
# aunque acaben subidos al servidor por error (gulpfile, manifest de npm,
# sourcemaps con el código original sin minificar, node_modules).
<FilesMatch "(^gulpfile\.js|^package(-lock)?\.json|\.scss|\.map)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^node_modules/ - [F,L]
    RewriteRule ^\.git - [F,L]
</IfModule>
